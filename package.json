{
  "name": "melperjs",
  "description": "Utility library for strings, objects, tokens, hashing, cookies, proxies, file/shell helpers and more.",
  "keywords": [
    "melperjs",
    "utilities",
    "utils",
    "helpers",
    "javascript",
    "nodejs",
    "esm",
    "cjs",
    "string",
    "object",
    "random",
    "token",
    "uuid",
    "bcrypt",
    "hash",
    "crypto",
    "cookie",
    "base64",
    "proxy",
    "file-system",
    "shell"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mahelbir/melperjs.git"
  },
  "author": "Mahmuthan Elbir",
  "license": "MIT",
  "type": "module",
  "files": [
    "lib/**/*"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./lib/esm/index.mjs",
      "require": "./lib/cjs/index.cjs"
    },
    "./node": {
      "import": "./lib/esm/node.mjs",
      "require": "./lib/cjs/node.cjs"
    }
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "cross-env BABEL_ENV=esm babel ./src --out-dir ./lib/esm --out-file-extension .mjs",
    "build:cjs": "cross-env BABEL_ENV=cjs babel ./src --out-dir ./lib/cjs --out-file-extension .cjs",
    "test": "node --test 'tests/**/*.test.js'",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "hpagent": "^1.2.0",
    "lodash": "4.18.1",
    "set-cookie-parser": "^3.1.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "babel-plugin-replace-import-extension": "^1.1.5",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "cross-env": "^10.1.0"
  },
  "version": "15.0.0"
}
